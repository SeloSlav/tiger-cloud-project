# Optional: scripts use the Tiger CLI default service and OS keyring if omitted.
# Never prefix a database credential with NEXT_PUBLIC_ or VITE_.
TIGER_SERVICE_ID=
DATABASE_URL=

# Live API runtime: a restricted role with EXECUTE on monitor_snapshot(),
# configured as a secret in the hosting provider. Never use the admin URL here.
FROSTLINE_DATABASE_URL=
# Default verify-full. Tiger free services require an explicit `require` mode
# because they use self-signed certificates; that mode encrypts but does not verify the CA.
FROSTLINE_TLS_MODE=verify-full
